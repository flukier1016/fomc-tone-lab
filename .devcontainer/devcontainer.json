{
  "name": "FOMC Tone Lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "make setup && make demo-data",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Dashboard", "onAutoForward": "openBrowser" } },
  "postAttachCommand": "echo 'Ready: run  make serve  and open the forwarded port 8000'",
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] } }
}
